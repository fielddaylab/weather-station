#basePath   Argo

:: Argo
@trigger    ArgoPressed
@evalPriority   100
@once

$call Wait(1)

{@Argo #happy} {poses 5.8:,7.0:unamused} Ah, un chico nuevo. Encantado de conocerte. Y ... Alex, tú también estás aquí. $[argo_ahh_youre]
{@Alex} Gracias, Argo. Encantado de verte también. Cuál es la situación? $[alex_gee_thanks]

{@Argo} La estación está sin electricidad. El culpable más probable es el panel solar. Parece estar en ángulo opuesto al sol. $[argo_well_at]

$call argoHelpButton->SetCurrentClip(0)

{@Rae} Hmph. Debe haber sido atrapado en una tormenta de viento. $[alex_hmm_must]

{@Argo} Bien, chico nuevo.... $[argo_ok_new]
{@Alex} Su nombre es Matt, Argo. Lo estoy entrenando. $[alex_his_name]
{@Argo} Excelente. Entonces, Matt, para alcanzar el equipo en la torre, puedes subirlo y bajarlo hasta que esté al alcance de tu brazo. $[to_reach_the]


// activate handles
$call rightPanelHandle->PlayFX()
$call rightPanelHandle->ShowHighlight()
$call rightPanelHandle->SetGrabbable(true)
$call rightPanelHandle->PlaySound()
$call leftPanelHandle->PlayFX()
$call leftPanelHandle->SetGrabbable(true)
$call leftPanelHandle->PlaySound()

$if PuzzleIsNotComplete(solarPanel)
    {@Argo} Centrémonos en el panel solar, coge el panel con las manos y gíralo hasta que se llene la barra solar. $[alex_ok_we]
    $while PuzzleIsNotComplete(solarPanel)
        $call Wait(1)
    $endwhile
$endif

$call solarPanel->PlaySound()

// deactivate handles
$call leftPanelHandle->StopFX()
$call leftPanelHandle->SetGrabbable(false)
$call leftPanelHandle->StopSound()
$call rightPanelHandle->StopFX()
$call rightPanelHandle->StopHighlight()
$call rightPanelHandle->StopSound()
$call rightPanelHandle->SetGrabbable(false)

$call argoHelpButton->SetButtonLocked(true)