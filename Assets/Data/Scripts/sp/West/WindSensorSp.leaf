#basePath   WindSensorSp

:: WindSensorSp
@trigger    SolarPanelCompleteSp
@evalPriority   100
@once

{@Argo #celebrate} El panel genera electricidad.  Excelente trabajo, compañero. $[argo_the_panel]
{@Alex} Argo, ¿está arreglada la estación? $[alex_argo_is]
$call windSensorSocket->SetLocked(false)
$call windSensor->SetGrabbable(true)
$call windSensor->ShowHighlight()
$call windSensor->PlaySound()
$call windSensor->PlayFX()
$call windSensorSled->PlayFX()
{@Argo} Todavía no. Parece que el sensor de viento está roto. Matt tendrá que reemplazarlo por un modelo actualizado. $[argo_hmm_not]
{@Argo} Si alguna vez necesitas ayuda, pulsa mi gran botón rojo. $[if_you_ever]

$if NotIsGrabbed(windSensor), NotIsSocketed(windSensorSled)
{@Argo} Bien, el primer paso es quitar el sensor de viento de la torre. $[argo_ok_first]
$call argoHelpButton->SetCurrentClip(1)
$call argoHelpButton->SetButtonLocked(false)
$while NotIsGrabbed(windSensor), NotIsSocketed(windSensorSled)
$call Wait(1)
$endwhile
$call argoHelpButton->SetButtonLocked(true)
$endif

$call windSensor->StopHighlight()
$call windSensor->StopFX()
$call windSensor->StopSound()

$call argo->SetGrabbable(true)
$call argo->PlayFX()
$call argoTowerSocket->SetLocked(false)
$call argoSled->PlayFX()

$if NotIsSocketed(windSensorSled)
{@Argo} Genial! Ahora colócalo en el soporte del trineo. $[argo_great_now]
$call argoHelpButton->SetCurrentClip(2)
$call argoHelpButton->SetButtonLocked(false)
$while NotIsSocketed(windSensorSled)
$call Wait(1)
$endwhile
$call argoHelpButton->SetButtonLocked(true)
$endif

$call windSensorSled->StopFX()

$if NotIsSocketed(argoSled)
{@Argo #celebrate} {poses 1:,3.5:happy} Impresionante. Bueno, sólo una última cosa. Méteme en el trineo. $[argo_awesome_ok]
$call argoHelpButton->SetCurrentClip(3)
$call argoHelpButton->SetButtonLocked(false)
$while NotIsSocketed(argoSled)
$call Wait(1)
$endwhile
$call argoHelpButton->SetButtonLocked(true)
$endif

$call argo->StopFX()
$call argoSled->StopFX()

// ensure all required components are in the sled
$set global:west-all-socketed = false
$while global:west-all-socketed != true
    $set global:west-all-socketed = true
    $if NotIsSocketed(argoSled)
        $set global:west-all-socketed = false
    $endif
    $if NotIsSocketed(windSensorSled)
        $set global:west-all-socketed = false
    $endif
    $if global:west-all-socketed != true
        $call Wait(1)
    $else
        $call argoSled->SetLocked(true)
        $call windSensorSled->SetLocked(true)
    $endif
$endwhile

{@Argo #irritated} {poses 0.97:eyerollsmile,3.333:,} Uf, podría haber sido un poco más suave. Pero no importa, ¡A la unidad de reparación! $[argo_could_have]
$call fader->FadeOut(3.0)
$call Wait(4)
// free argo to be placed in interior
$call argoSled->SetLocked(false)
$call playerLocation->Teleport()
$call Wait(4)
$call fader->FadeIn(3.0, 1.0)
$call map->SetTexture(0)

$call Wait(3)
$call windSensorSled->SetLocked(false)

{@Argo #happy} {poses 4.0:} Ah, la unidad móvil de reparación. Hogar, dulce hogar. Esta unidad tiene todo lo necesario para realizar reparaciones esenciales. Mira a ver si encuentras un sensor de viento de repuesto. $[argo_ah_the]
$call windSensor->ShowHighlight()
$call windSensor->PlaySound()
$call windSensor->PlayFX()
$call windSensorBay->PlayFX()
$call windSensorBay->PlaySound()
$call windSensorBay->ShowHighlight()
$call trashChute->SetGrabbable(true)

$if IsSocketed(windSensorSled)
{@Argo} Tienes que sacar el sensor de viento del trineo y colocarlo en el muelle de reparación de sensores de viento. $[argo_you_need]

$call argoHelpButton->SetCurrentClip(4)
$call argoHelpButton->SetButtonLocked(false)
$while IsSocketed(windSensorSled)
$call Wait(1)
$endwhile
$call argoHelpButton->SetButtonLocked(true)
$endif

$call windSensor->StopHighlight()
$call windSensor->StopSound()
$call windSensor->StopFX()

$if NotIsSocketed(windSensorBaySocket)
{@Argo} Estupendo. Ahora colócalo en el muelle de reparación de tu banco de trabajo. Con cuidado. Esas cosas cuestan varios miles de dólares. $[argo_great_nowset]

$call argoHelpButton->SetCurrentClip(5)

$call argoHelpButton->SetButtonLocked(false)
$while NotIsSocketed(windSensorBaySocket)
$call Wait(1)
$endwhile
$call argoHelpButton->SetButtonLocked(true)
$endif

$call windSensorBay->StopFX()
$call windSensorBay->StopSound()
$call windSensorBay->StopHighlight()

$call windSensor->SetGrabbable(false)

$call brokenBlade->PlayFX()
$call brokenBlade->ShowHighlight()
$call windSensorBladeSocket->SetLocked(false)

$if NotWasGrabbed(brokenBlade)
{@Argo} Wonderful, ok, it looks like the propeller unit is bad, take it off the wind sensor. $[argo_wonderful_ok]
$call argoHelpButton->SetCurrentClip(6)
$call argoHelpButton->SetButtonLocked(false)
$while NotWasGrabbed(brokenBlade)
$call Wait(2)
$endwhile
$call argoHelpButton->SetButtonLocked(true)
$endif

$call brokenBlade->StopFX()
$call brokenBlade->StopHighlight()


$call trashChute->PlayFX()
$call trashChute->ShowHighlight()

$if TrashWasNotGrabbed(trashChute)
{@Argo} Estupendo. Esto es basura ahora, así que tenemos que empaquetarlo. Hay un cubo de basura debajo de tu mesa. $[argo_great_this]
$call argoHelpButton->SetCurrentClip(7)
$call argoHelpButton->SetButtonLocked(false)
//$while TrashWasNotGrabbed(trashChute)
//$call Wait(1)
//$endwhile
$call argoHelpButton->SetButtonLocked(true)
$endif

$call trashChute->StopFX()
$call trashChute->StopHighlight()

$call propM->PlayFX()
$call propM->ShowHighlight()
$call propM->SetGrabbable(true)
$call propS->PlayFX()
$call propS->ShowHighlight()
$call propS->SetGrabbable(true)

$if NotWasGrabbed(propM), NotWasGrabbed(propS)

{@Argo} Sustituyamos esa hélice mala por una buena.  Detrás de ti está tu inventario.  Coge una hélice nueva y comprueba si encaja bien. $[argo_lets_replace]

$call argoHelpButton->SetButtonLocked(false)

$while NotWasGrabbed(propM), NotWasGrabbed(propS)

$call Wait(1)

$if WasGrabbed(propM)
$call propM->StopFX()
$call propM->StopHighlight()
$endif

$if WasGrabbed(propS)
$call propS->StopFX()
$call propS->StopHighlight()
$endif

$endwhile

$endif

$call argoHelpButton->SetButtonLocked(true)

$if NotIsPuzzleSocketed(windSensorBladeSocket)
{@Argo} Magnífico! Ahora ponlo en el sensor de viento y veremos si coincide. $[argo_great_now2]
$call argoHelpButton->SetCurrentClip(8)
$call argoHelpButton->SetButtonLocked(false)
$while NotIsPuzzleSocketed(windSensorBladeSocket)
$call Wait(1)
$endwhile
$call argoHelpButton->SetButtonLocked(true)

$endif

$call windSensorButton->ShowHighlight()
$call windSensorButton->PlayFX()
$call windSensorButton->SetButtonPressed(false)

$if ButtonNotPressed(windSensorButton)
    {@Argo} Ahora vamos a probarlo. Pulsa el botón de prueba. $[argo_now_lets]
$endif

$call windSensorButton->StopHighlight()
$call windSensorButton->StopFX()

$while PuzzleIsNotComplete(windSensorPuzzle)

    $call Wait(1)

    $call argoHelpButton->SetCurrentClip(9)
    $call argoHelpButton->SetButtonLocked(false)
        $while ButtonNotPressed(windSensorButton)
            $call Wait(1)
        $endwhile
    $call argoHelpButton->SetButtonLocked(true)

    $if IsNotMatched(windSensorBladeSocket)
        {@Argo} Esa no es la talla correcta. Probemos con otra. $[argo_hmm_thats]
        $call argoHelpButton->SetCurrentClip(10)
		$call windSensorButton->ShowHighlight()
		$call windSensorButton->PlayFX()
        $call windSensorButton->SetButtonPressed(false)
    $else
		$call windSensorButton->StopHighlight()
		$call windSensorButton->StopFX()
        $call windSensorPuzzle->SetTestSuccess(true)
    $endif

$endwhile

$call windSensorPuzzle->PlaySound()

$call windSensorButton->StopHighlight()
$call windSensorButton->StopFX()

$call propS->StopFX()
$call propS->StopHighlight()