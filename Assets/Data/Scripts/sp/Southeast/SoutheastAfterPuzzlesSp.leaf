#basePath   SoutheastAfterPuzzlesSp

:: SoutheastAfterPuzzlesSp
@trigger    LevelFivePuzzlesFinishedSp
@evalPriority   100
@once

$while NotIsSocketed(snowSledSocket)
    $call Wait(1)
$endwhile

$while NotIsSocketed(batterySledSocket)
    $call Wait(1)
$endwhile

$call argoFunButton->SetButtonLocked(true)
$call argoHelpButton->SetButtonLocked(true)

{@MissionControl} Nutria 3, tenemos una situación. La tormenta se dirige ahora hacia ti. Abortar misión. $[otter_three_weve]
{@Rae} Ah, lo llamé. Muy bien, empaca, nos vamos de aquí. $[ha_called_it]
{@Alex} Espera, esta es la última reparación de la temporada, y esta estación es esencial para nuestra investigación. Control de Misión, ¿qué riesgo correría si nos quedáramos aquí y siguiéramos trabajando? $[wait_this_is]
{@MissionControl} Teóricamente posible, pero no aconsejable. $[theoretically_possible_but]
{@Alex} Vale, Ray, deberías irte. Nosotros nos quedamos. Matt, pon al Capitán Chatterbox en el trineo y arreglemos la torre. Prepararé un refugio. $[okay_rae_you]
{@Rae} Intentaré volver a por ti mañana. $[affirmative_ill_try]

$call argoHelpButton->SetButtonLocked(false)
$call argoHelpButton->SetCurrentClip(33)

$call argo->SetGrabbable(true)
$call argo->PlayFX()
$call argoTowerSocket->SetLocked(false)
$call argoSled->PlayFX()

$if NotIsSocketed(argoSled)
$while NotIsSocketed(argoSled)
$call Wait(1)
$endwhile
$endif

$set global:southeast-all-socketed = false
$while global:southeast-all-socketed != true
    $set global:southeast-all-socketed = true
    $if NotIsSocketed(argoSled)
        $set global:southeast-all-socketed = false
    $endif
    $if NotIsSocketed(snowSledSocket)
        $set global:southeast-all-socketed = false
    $endif
    $if NotIsSocketed(batterySledSocket)
        $set global:southeast-all-socketed = false
    $endif
    $if global:southeast-all-socketed != true
        $call Wait(1)
    $else
        $call argoSled->SetLocked(true)
        $call snowSledSocket->SetLocked(true)
        $call batterySledSocket->SetLocked(true)
    $endif
$endwhile

$call argo->StopFX()
$call argoSled->StopFX()

$call fader->FadeOut(3.0)
$call Wait(4)
$call argoSled->SetLocked(false)
$call playerLocation->Teleport()
$call tent->SetDisabled(false)
$call alex->StartKneeling()

$call storageCabinet->SetDisabled(true)
$call planeLeaving->SetDisabled(false)
//$call snow->IncreaseParticles(10000, 2000.0)
$call batteryBroken->SetDisabled(true)
$call batteryOne->SetDisabled(true)
$call batteryTwo->SetDisabled(true)
$call batteryThree->SetDisabled(true)
$call batteryOneThree->SetDisabled(true)
$call batteryTwoThree->SetDisabled(true)
$call batteryThreeThree->SetDisabled(true)
$call batteryOneThreeStag->SetDisabled(true)
$call batteryTwoThreeStag->SetDisabled(true)
$call batteryThreeThreeStag->SetDisabled(true)
$call propExtra->SetDisabled(true)
$call propExtra2->SetDisabled(true)
$call cellOne->SetDisabled(true)
$call cellTwo->SetDisabled(true)
$call cellThree->SetDisabled(true)
$call cellFour->SetDisabled(true)

$call dataLoggerDoor->ResetRotation()
$call dataLoggerDoor->SetGrabbable(false)
$call Wait(4)
$call argoTowerSocket->SetLocked(true)
$call planeToHide->SetDisabled(true)
$call fader->FadeIn(3.0, 1.0)

$call argoHelpButton->SetButtonLocked(true)

$call snowSledSocket->SetLocked(false)
$call batterySledSocket->SetLocked(false)

{@Rae} Stay safe, I’ll be back tomorrow...I hope. $[stay_safe_ill]

$call argoHelpButton->SetButtonLocked(false)
$call argoHelpButton->SetCurrentClip(34)

$call snowSensor->PlayFX()
$call snowSensor->ShowHighlight()

$call batteryBase->PlayFX()
$call batteryBase->ShowHighlight()

$call snowTowerSocket->ShowHighlight()
$call snowTowerSocket->PlayFX()

$call batterySnowSocket->PlayFX()

{@Alex} Espera, ¿cómo vamos a probar la conexión sin la unidad de reparación aquí? $[wait_how_are]
{@Argo} Puedo probar la conexión yo solo. $[i_can_test]
{@Alex} Vaya, ¿en serio? Nunca pensé que diría esto, Argo. Estoy impresionado. $[wow_really_i]
{@Argo} Bueno, soy muy impresionante. $[well_i_am]


$while NotIsSocketed(snowTowerSocket), NotIsSocketed(batterySnowSocket)
    $call Wait(1)
$endwhile

$if NotIsSocketed(batterySnowSocket)
    $call snowTowerSocket->StopHighlight()
    $call snowTowerSocket->StopFX()
    $call snowSensor->StopFX()

    $while NotIsSocketed(batterySnowSocket)
        $call Wait(1)
    $endwhile
    $call batterySnowSocket->StopFX()
    $call batteryBase->StopFX()
    $call batteryBase->StopHighlight()
    $call batteryBase->PlaySound()
$endif

$if NotIsSocketed(snowTowerSocket)
    $call batterySnowSocket->StopFX()
    $call batteryBase->StopFX()
    $call batteryBase->StopHighlight()
    $while NotIsSocketed(snowTowerSocket)
        $call Wait(1)
    $endwhile
    $call snowTowerSocket->StopHighlight()
    $call snowTowerSocket->StopFX()
    $call snowSensor->StopFX()
$endif

$call batterySnowSocket->StopFX()
$call batteryBase->StopFX()
$call batteryBase->StopHighlight()
$call batteryBase->StopSound()
$call snowSensor->StopFX()
$call snowSensor->StopHighlight()
$call snowTowerSocket->StopHighlight()
$call snowTowerSocket->StopFX()

$call argoHelpButton->SetButtonLocked(true)
$call argoFunButton->SetButtonLocked(true)

{@Alex} Muy bien, el momento de la verdad. Argo, ¿cómo lo hicimos? $[okay_moment_of]
{@Argo} ¡La estación está transmitiendo! Todos los sensores vuelven a estar en línea. $[the_station_is]
{@Alex} No puedo creerlo, ¡lo hicimos! Matt, Argo, buen trabajo. Bien, mejor nos cubrimos. $[i_cant_believe]
{@Argo} Sí, en estas condiciones, los humanos pueden sufrir congelación en tan sólo cinco minutos. Sin embargo, estaré bien. Estaba hecho para el frío. $[yes_in_these]
{@Alex} ¿Estamos seguros de que Argo no tiene un botón de silencio? $[are_we_positive]

$call fader->FadeOut(4.0)
$call Wait(4)
$call playerLocation->SetFinalLocation()
$call levelLoader->LoadEpilogue()
