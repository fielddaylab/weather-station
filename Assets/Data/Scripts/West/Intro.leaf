#basePath   Intro

:: Introduction
@trigger    GameReady
@evalPriority   100
@once

$call fader->FadeIn(4.0, 2.0)
$call argoHelpButton->SetButtonLocked(false)
$call argo->SetFacePose("sleeping")
{@Rae} Mission Control, this is Otter three, We just touched down at Mount Rea Station. Sky’s clear as a bell, temperature clocking in at -15 degrees Fahrenheit. Perfect daytime conditions. $[rae_mission_control]
{@Alex} Sure, perfect. If you’re a penguin. $[alex_sure_perfect]
{@Alex} Station's a little beat up. Not too bad, considering how long we've been away.  But it looks like there's no power. $[alex_stations_a]
{@Rae} We don't have time to mess around.  We've only got two hours of clear weather before I need to get this plane in the sky. You guys better boot up Argo. $[rae_we_dont]
{@Alex} Thanks Rae, alright Matt, looks like time isn't on our side. Do you see Argo on the tower? Press the red button to boot him up. $[alex_alright_matt]
{@Matt} Um, yeah, I think I can figure it out. $[matt_uh_yeah]
$while HelpButtonNotPressed(argoHelpButton)
$call Wait(1)
//$if ButtonNotPressed(argo)
//{@Alex} Press Argo's red button to boot him up. $[alex_matt_press]
//$endif
$endwhile
$call argoHelpButton->SetButtonLocked(true)